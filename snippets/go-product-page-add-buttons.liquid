<product-form class="product-form go-product-page-form-wrapper-copy">
  <div class="product-form__error-message-wrapper" role="alert" hidden>
    <svg
      aria-hidden="true"
      focusable="false"
      role="presentation"
      class="icon icon-error"
      viewBox="0 0 13 13"
    >
      <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
      <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
      <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
      <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
    </svg>
    <span class="product-form__error-message"></span>
  </div>

  {% if coming_soon %}
    <div
      class="sg-product-page-button-coming-soon"
    >
      <span>
        {{ coming_soon_text }}
      </span>
    </div>
    <style>
      .sg-product-page-button-coming-soon {
        background-color: #000;
        color: #fff;
        text-transform: uppercase;
        transform-style: preserve-3d;
        background-color: #000;
        flex: none;
        width: 100%;
        height: 54px;
        padding: 0 20px;
        font-family: proxima-nova, sans-serif;
        font-size: 17px;
        font-weight: 700;
        display: flex;
        justify-content: center;
        align-items: center;
      }
    </style>

  {% else %}
    {%- form 'product',
      product,
      id: product_form_id,
      class: 'form',
      novalidate: 'novalidate',
      data-type: 'add-to-cart-form'
    -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled>
      <div class="product-form__buttons">
        {% assign coming_soon = product.metafields.custom.coming_soon | default: false %}
        <button
          type="submit"
          name="add"
          class="sg-product-page-button product-form__submit button button--full-width button--primary {% if coming_soon %}sg-product-page-button--coming_soon{% endif %}"
          {% if product.selected_or_first_available_variant.available == false or coming_soon %}
            disabled
          {% endif %}
        >
          <div class="icon"><svg class="icon icon-cart" aria-hidden="true" focusable="false" role="presentation" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" fill="none">
            <path fill="currentColor" fill-rule="evenodd" d="M20.5 6.5a4.75 4.75 0 00-4.75 4.75v.56h-3.16l-.77 11.6a5 5 0 004.99 5.34h7.38a5 5 0 004.99-5.33l-.77-11.6h-3.16v-.57A4.75 4.75 0 0020.5 6.5zm3.75 5.31v-.56a3.75 3.75 0 10-7.5 0v.56h7.5zm-7.5 1h7.5v.56a3.75 3.75 0 11-7.5 0v-.56zm-1 0v.56a4.75 4.75 0 109.5 0v-.56h2.22l.71 10.67a4 4 0 01-3.99 4.27h-7.38a4 4 0 01-4-4.27l.72-10.67h2.22z"></path>
          </svg>
          </div>
          <span>
            {%- if coming_soon -%}
              {{ 'products.product.coming_soon' | t }}
            {%- elsif product.selected_or_first_available_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>
          <div class="loading-overlay__spinner hidden">
            <svg
              aria-hidden="true"
              focusable="false"
              role="presentation"
              class="spinner"
              viewBox="0 0 66 66"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
            </svg>
          </div>
        </button>
      </div>
      {{ form | payment_button }}
    {%- endform -%}
  {% endif %}
</product-form>

{% comment %} <form action="{{ routes.cart_url }}" method="post" id="product-checkout-form">
  <button class="button button--secondary button--full-width" name="checkout">{{ 'products.product.checkout' | t }}</button>
</form> {% endcomment %}